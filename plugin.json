{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "skill-lens",
  "version": "0.1.6",
  "description": "Display Codex skills and observed SKILL.md reads in a sidebar app.",
  "author": {
    "name": "Gemma"
  },
  "homepage": "https://github.com/gemma1044/skill-lens",
  "repository": "https://github.com/gemma1044/skill-lens",
  "license": "MIT",
  "extensions": {
    "com.openai": {
      "hooks": "./hooks/hooks.json",
      "interface": {
        "displayName": "Skill Lens",
    "shortDescription": "Display your Skills",
    "longDescription": "Open a read-only sidebar that directly displays Skills observed in the current session, with an optional full catalog and exact SKILL.md instructions.",
        "developerName": "Gemma",
        "category": "Developer Tools",
        "capabilities": ["Interactive", "Read"],
        "composerIcon": "./assets/icon.svg",
        "logo": "./assets/icon.svg",
        "logoDark": "./assets/icon-dark.svg"
      }
    }
  }
}
