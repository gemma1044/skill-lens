{
  "name": "skill-lens",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "A Codex sidebar plugin for displaying available skills and observed SKILL.md reads.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "preview": "tsx scripts/preview.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/server": "^2.0.0",
    "@openai/mcp-extensions": "^0.2.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "zod": "$zod"
  }
}
